{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "NPC Schema",
  "description": "Schema for NPC definitions in data/npcData.js",
  "type": "object",
  "required": ["id", "name", "greeting", "topics"],
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique NPC identifier (e.g., 'old_man')",
      "pattern": "^[a-z][a-z0-9_]+$"
    },
    "name": {
      "type": "string",
      "description": "Display name (e.g., 'Elder Rowan')"
    },
    "portrait": {
      "type": "string",
      "description": "Base64 SVG data URL or asset path"
    },
    "location": {
      "type": "string",
      "description": "Location ID where NPC appears"
    },
    "unlocked": {
      "type": "boolean",
      "description": "Whether NPC is available by default"
    },
    "unlockCondition": {
      "type": "string",
      "description": "Game flag required to unlock NPC"
    },
    "greeting": {
      "type": "string",
      "description": "First dialogue line when talking to NPC"
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "description": "Dialogue topics",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique topic identifier"
          },
          "text": {
            "type": "string",
            "description": "Player dialogue option"
          },
          "response": {
            "type": ["string", "null"],
            "description": "NPC response (null to close dialogue)"
          },
          "affection": {
            "type": "number",
            "minimum": 0,
            "description": "Affection points gained"
          },
          "flag": {
            "type": "string",
            "description": "Game flag to set when topic is selected"
          },
          "close": {
            "type": "boolean",
            "description": "Whether to close dialogue after this topic"
          }
        }
      }
    }
  }
}
